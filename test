#!/bin/sh
# ./test                  every implementation
# ./test pas              every Pascal suite
# ./test pas b4 b4i       selected suites
set -eu
cd "$(dirname "$0")"

usage() {
  echo "usage: ./test [language] [suite ...]" >&2
  echo "languages: pas js jlang (j) lil c bend gd" >&2
  echo "  ./test              test every implementation" >&2
  echo "  ./test pas          every Pascal suite" >&2
  echo "  ./test pas b4 b4i   those Pascal suites" >&2
  exit 2
}

run_lang() {
  lang=$1
  shift
  case $lang in
    j) lang=jlang ;;
  esac
  script=imp/test-$lang
  if [ ! -f "$script" ]; then
    echo "unknown language: $lang" >&2
    usage
  fi
  sh "$script" "$@"
}

if [ $# -eq 0 ]; then
  fail=0
  for lang in pas js jlang lil c bend gd; do
    echo "######## $lang ########"
    if run_lang "$lang"; then
      :
    else
      echo "FAILED $lang" >&2
      fail=1
    fi
  done
  exit $fail
fi

lang=$1
shift
run_lang "$lang" "$@"

#!/bin/sh
set -eu
cd "$(dirname "$0")"
make -C bend check b4i

# Own a tanco install so the suite works on a fresh checkout.
if [ -z "${TANCO:-}" ]; then
  venv=".venv"
  tanco="$venv/bin/tanco"
  if [ ! -x "$tanco" ]; then
    echo "Installing tanco into $venv"
    if [ ! -x "$venv/bin/python" ]; then
      # Debian's python3 omits ensurepip unless python3-venv is installed.
      python3 -m venv --without-pip "$venv"
    fi
    if ! "$venv/bin/python" -m pip --version >/dev/null 2>&1; then
      curl -fsSL https://bootstrap.pypa.io/get-pip.py | "$venv/bin/python"
    fi
    "$venv/bin/python" -m pip install tanco
  fi
  TANCO="$PWD/$tanco"
  export TANCO
fi

# tanco 0.4 exits 0 even when a test fails, so require its success line.
run_suite() {
  log=$(mktemp)
  "$TANCO" run -t "$1" -- bend/b4i | tee "$log"
  if grep -q '^All .* tests passed\.$' "$log"; then
    rm -f "$log"
  else
    rm -f "$log"
    return 1
  fi
}

run_suite b4-tests.org
run_suite bend/tests.org

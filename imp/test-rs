#!/bin/sh
# ./test rs [b4 b4i bios pre b4s b4h mem]
set -eu
ROOT=$(CDPATH= cd "$(dirname "$0")/.." && pwd)
. "$ROOT/imp/common.sh"
cd "$ROOT"
if [ "${1:-}" = "--list" ]; then
  echo "b4 b4i bios pre b4s b4h mem"
  exit 0
fi
ensure_tanco

if [ $# -eq 0 ]; then
  set -- b4 b4i bios pre b4s b4h mem
fi

(cd "$ROOT/imp/rs" && cargo build --release --quiet)
BIN=imp/rs/target/release

for suite in "$@"; do
  case $suite in
    b4)
      tanco_run b4-tests.org -- $BIN/b4i
      ;;
    b4i)
      tanco_run b4i-tests.org -- $BIN/b4i
      ;;
    bios)
      tanco_run bios-tests.org -- $BIN/b4i -a b4a/bios.b4a
      ;;
    pre)
      tanco_run pre-tests.org -- $BIN/b4i -a b4a/pre.b4a
      ;;
    b4s)
      tanco_run b4s-tests.org -- $BIN/b4i -a b4a/bios.b4a -a b4a/pre.b4a -a b4a/b4s.b4a
      ;;
    b4h)
      tanco_run b4h-tests.org -- $BIN/b4h
      ;;
    mem)
      tanco_run mem-tests.org -- $BIN/b4i
      ;;
    *)
      echo "rs: unknown suite '$suite'" >&2
      echo "suites: b4 b4i bios pre b4s b4h mem" >&2
      exit 2
      ;;
  esac
done

#!/bin/sh
# ./test lil [b4 b4i b4h]
set -eu
ROOT=$(CDPATH= cd "$(dirname "$0")/.." && pwd)
. "$ROOT/imp/common.sh"
cd "$ROOT"
ensure_tanco

if [ $# -eq 0 ]; then
  set -- b4 b4i b4h
fi

if ! command -v lilt >/dev/null 2>&1; then
  echo "lil: lilt not found" >&2
  exit 1
fi

export INPUT_PATH=input.txt

for suite in "$@"; do
  case $suite in
    b4)
      tanco_run b4-tests.org -c "lilt imp/lil/b4i.lil input.txt"
      ;;
    b4i)
      tanco_run b4i-tests.org -c "lilt imp/lil/b4i.lil input.txt"
      ;;
    b4h)
      tanco_run b4h-tests.org -c "lilt imp/lil/b4h.lil input.txt"
      ;;
    *)
      echo "lil: unknown suite '$suite'" >&2
      echo "suites: b4 b4i b4h" >&2
      exit 2
      ;;
  esac
done
